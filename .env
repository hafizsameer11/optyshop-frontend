# OptyShop Environment Variables
# This file contains sensitive information and should NOT be committed to git
# Copy from .env.example and fill in your actual values

# API base: Vite reads this only when dev server or build starts (restart after edits).
# Remote: https://optyshop-frontend.hmstech.org/api
# Local backend: http://localhost:5000/api
VITE_API_BASE_URL=https://optyshop-frontend.hmstech.org/api


# Stripe Configuration
# Replace with your actual Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=
