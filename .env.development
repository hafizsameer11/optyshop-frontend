# Loaded only for `npm run dev` (Vite mode: development).
# Overrides the same keys from `.env` so the dev server hits the live API by default.
# To use a local backend instead, create `.env.development.local` (gitignored) with:
#   VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=https://optyshop-frontend.hmstech.org/api
