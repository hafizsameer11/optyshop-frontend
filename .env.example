# OptyShop Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
# Base URL for the backend API (no trailing slash)
# For `npm run dev`, `.env.development` overrides this if present (see that file in the repo).
# Local backend example: http://localhost:5000/api
VITE_API_BASE_URL=https://optyshop-frontend.hmstech.org/api

# Stripe Configuration
# Your Stripe publishable key (starts with pk_)
# Get it from: https://dashboard.stripe.com/apikeys
# Use pk_test_... for development/testing
# Use pk_live_... for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Contact form — optional: deliver submissions to your inbox without backend email (https://web3forms.com)
# If unset, the app uses POST /api/forms/contact/submissions (configure SMTP/email on the server).
# VITE_WEB3FORMS_ACCESS_KEY=
